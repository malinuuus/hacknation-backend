NODE_ENV=development
PORT=3000

POSTGRES_USER=hacknation
POSTGRES_PASSWORD=hacknation
POSTGRES_DB=hacknation
POSTGRES_PORT=5432

# Prisma connection string
DATABASE_URL=postgresql://hacknation:hacknation@localhost:5432/hacknation?schema=public

# JWT
# Generate a secret with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

CORS_ORIGINS=http://localhost:5173
AUTH_COOKIE_SAME_SITE=lax

CASE_NUMBER_PREFIX=BKS.IV.1431

# Uploaded documents (local disk)
UPLOAD_DIR=storage/uploads
UPLOAD_MAX_FILE_SIZE_MB=20

# Demo account created by `pnpm prisma:seed:demo` (optional)
# SEED_DEMO_EMAIL=urzednik@example.com
# SEED_DEMO_PASSWORD=change-me

# OpenAI (AI module: request extraction, knowledge base RAG, drafting)
# Leave OPENAI_API_KEY empty to run without AI: /cases/analyze falls back to pattern matching
# and the AI endpoints answer 503 AI_NOT_CONFIGURED.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_TIMEOUT_MS=45000
# OPENAI_OCR_TIMEOUT_MS=60000

# Knowledge base retrieval (RAG)
# RAG_TOP_K=6
# RAG_CHUNK_SIZE=1000
# RAG_CHUNK_OVERLAP=150
