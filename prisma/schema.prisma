generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  createdCases  Case[]             @relation("CaseCreatedBy")
  assignedCases Case[]             @relation("CaseAssignee")
  statusChanges CaseStatusChange[]

  @@map("users")
}

enum CaseStatus {
  NEW
  SENT_TO_DEPARTMENTS
  EXTENDED
  RESPONSE_PREPARED
  RESPONSE_SENT

  @@map("case_status")
}

model Case {
  id               String     @id @default(uuid()) @db.Uuid
  year             Int?
  sequenceNumber   Int        @map("sequence_number")
  caseNumber       String     @unique @map("case_number")
  subject          String
  receivedAt       DateTime   @map("received_at") @db.Date
  dueAt            DateTime   @map("due_at") @db.Date
  extendedDueAt    DateTime?  @map("extended_due_at") @db.Date
  extensionReason  String?    @map("extension_reason")
  respondedAt      DateTime?  @map("responded_at") @db.Date
  status           CaseStatus @default(NEW)
  handlerInitials  String?    @map("handler_initials")
  requesterName    String?    @map("requester_name")
  requesterEmail   String?    @map("requester_email")
  requesterAddress String?    @map("requester_address")
  notes            String?
  assigneeId       String?    @map("assignee_id") @db.Uuid
  createdById      String     @map("created_by_id") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  assignee      User?              @relation("CaseAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy     User               @relation("CaseCreatedBy", fields: [createdById], references: [id])
  statusChanges CaseStatusChange[]

  @@unique([year, sequenceNumber])
  @@index([year, receivedAt])
  @@map("cases")
}

model CaseStatusChange {
  id          String      @id @default(uuid()) @db.Uuid
  caseId      String      @map("case_id") @db.Uuid
  fromStatus  CaseStatus? @map("from_status")
  toStatus    CaseStatus  @map("to_status")
  comment     String?
  changedById String      @map("changed_by_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at")

  case      Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  changedBy User @relation(fields: [changedById], references: [id])

  @@index([caseId, createdAt])
  @@map("case_status_changes")
}
